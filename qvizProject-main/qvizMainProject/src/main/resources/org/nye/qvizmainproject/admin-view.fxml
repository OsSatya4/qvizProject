<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="15.0" alignment="TOP_CENTER" prefWidth="600.0" prefHeight="550.0"
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.nye.qvizmainproject.controller.AdminController">
    <padding>
        <Insets top="20.0" right="20.0" bottom="20.0" left="20.0"/>
    </padding>

    <Label text="Adminisztrátori Felület" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>

    <!-- 1. Új kategória hozzáadása -->
    <HBox spacing="10.0" alignment="CENTER_LEFT">
        <Label text="Új kategória:"/>
        <TextField fx:id="categoryField" promptText="pl. Biológia" HBox.hgrow="ALWAYS"/>
        <Button text="Hozzáadás" onAction="#handleAddCategory"/>
    </HBox>

    <Separator/>

    <!-- 2. Új kérdés felvétele -->
    <Label text="Új kérdés felvétele" style="-fx-font-weight: bold;"/>
    <GridPane hgap="10.0" vgap="8.0">
        <Label text="Kategória ID:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="categoryIdField" promptText="pl. 1" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

        <Label text="Kérdés:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <TextField fx:id="questionField" promptText="Írd ide a kérdést..." GridPane.rowIndex="1" GridPane.columnIndex="1" prefWidth="400"/>

        <Label text="A válasz:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <TextField fx:id="ansAField" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

        <Label text="B válasz:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
        <TextField fx:id="ansBField" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

        <Label text="C válasz:" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
        <TextField fx:id="ansCField" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

        <Label text="D válasz:" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
        <TextField fx:id="ansDField" GridPane.rowIndex="5" GridPane.columnIndex="1"/>

        <Label text="Helyes (0-3):" GridPane.rowIndex="6" GridPane.columnIndex="0"/>
        <TextField fx:id="correctIndexField" promptText="0=A, 1=B, 2=C, 3=D" GridPane.rowIndex="6" GridPane.columnIndex="1"/>
    </GridPane>

    <Button text="Kérdés mentése" onAction="#handleAddQuestion" maxWidth="Infinity"/>

    <Separator/>

    <!-- 3. Kérdés törlése -->
    <HBox spacing="10.0" alignment="CENTER_LEFT">
        <Label text="Törlendő kérdés ID:"/>
        <TextField fx:id="deleteIdField" promptText="pl. 2" prefWidth="100"/>
        <Button text="Törlés" onAction="#handleDeleteQuestion" style="-fx-background-color: #d9534f; -fx-text-fill: white;"/>
    </HBox>

    <!-- Visszajelzés a felhasználónak -->
    <Label fx:id="statusLabel" text="" style="-fx-text-fill: green; -fx-font-weight: bold;"/>
</VBox>